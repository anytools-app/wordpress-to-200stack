MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=replace-with-server-only-api-key

NEXT_PUBLIC_MICROCMS_SERVICE_DOMAIN=your-service-domain
NEXT_PUBLIC_MICROCMS_PREVIEW_KEY=replace-with-read-only-preview-key
