# microCMS モード (WPKIT_DATA_SOURCE=microcms、または未指定時) に必要
MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=replace-with-server-only-api-key

# WordPress uploads を同期した CDN / R2 の公開ホスト。クライアント側で参照する場合だけ公開する。
NEXT_PUBLIC_MEDIA_HOST=https://media.example.com

# 任意: sitemap・canonical の絶対 URL に使う公開 origin
NEXT_PUBLIC_SITE_URL=https://www.example.com

# 任意: IR ディレクトリ (既定: テンプレート配置先/site の ../ir)
# WPKIT_IR_DIR=../ir

# 任意: iframe を許可するホストのカンマ区切り。未指定時は安全な既定リストを使用。
# WPKIT_IFRAME_HOSTS=www.youtube.com,player.vimeo.com
